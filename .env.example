# Cursor API Key (必填)
# 获取方式: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=your_cursor_api_key_here

# Remote CLI → agentsdk.run 网关（http + 端口 3000，视你域名与 TLS 情况而定）
AGENTSDK_CLOUD_URL=http://agentsdk.run:3000

# 可选：覆盖 VPS 工作目录路径（不写则服务端用 DEFAULT_AGENT_CWD）
# CLOUD_AGENT_CWD=/home/xinference/agent-workspace

# 可选：默认模型 id（也可用会话内命令 /model gpt-5.4）
# CURSOR_MODEL=gpt-5.4

# Windsurf API Key (可选，待实现)
# WINDSURF_API_KEY=
